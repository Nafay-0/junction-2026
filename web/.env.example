# All optional. With none set, Dock runs keyless: an ephemeral wholesaler key and a demo buyer key
# derived from a public string (fine locally, NOT for a public deployment).
# Private Ed25519 JWK (JSON on one line) the wholesaler signs quotes and order confirmations with.
DOCK_WHOLESALER_JWK=
# Private Ed25519 JWK of the demo buyer org (Laakso Catering Oy). Give the demo script the same value.
DOCK_DEMO_ORG_JWK=

# Partner catalogue (Valio Aimo). With VALIO_API_KEY set and the index built (`pnpm index:build`), Dock uses the
# real catalogue and the live price/availability API; otherwise it runs on the 12-product seed.
# Base URL of the partner's mock API (default https://junction26.valioaimo.fi).
VALIO_API_BASE=
# Key for the X-API-Key header (published on the Junction Platform). Never commit it.
VALIO_API_KEY=
# Customer id sent with each request (required by the API, ignored in the challenge; default "dock").
VALIO_CUSTOMER=
# Folder with the partner's data files (default: ../data/valio, seen from web/). Never commit the files.
VALIO_DATA_DIR=
# Index file written by `pnpm index:build` and read at runtime (default: .data/valio/catalog-index.json.gz, git-ignored).
VALIO_INDEX_PATH=
# Set to "seed" to force the seed catalogue even when the real one is available.
DOCK_CATALOG=
