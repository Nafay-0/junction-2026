# All optional. With none set, Dock runs keyless: an ephemeral wholesaler key and a demo buyer key
# derived from a public string (fine locally, NOT for a public deployment).
# Private Ed25519 JWK (JSON on one line) the wholesaler signs quotes and order confirmations with.
DOCK_WHOLESALER_JWK=
# Private Ed25519 JWK of the demo buyer org (Laakso Catering Oy). Give the demo script the same value.
DOCK_DEMO_ORG_JWK=
# Private Ed25519 JWK of the demo returning kitchen (Ravintola Kaari). Give the demo script the same value.
DOCK_DEMO_KITCHEN_JWK=

# Phone approval (passkeys). All optional for local runs on localhost.
# Public https base of this app: links, QR codes and the passkey origin. Unset: taken from the request's host.
DOCK_PUBLIC_URL=
# Passkey relying-party id (a domain, no scheme). Default: the host of DOCK_PUBLIC_URL / the request.
DOCK_WEBAUTHN_RP_ID=
# Comma-separated origins passkeys may be used from. Default: DOCK_PUBLIC_URL / the request's origin.
DOCK_WEBAUTHN_ORIGINS=
# Name shown in the phone's passkey prompt. Default: Dock.
DOCK_WEBAUTHN_RP_NAME=
# DEMO ONLY. Set to 1 to offer tap-to-approve without a passkey when passkeys fail. Recorded as unverified. Default off.
DOCK_DEMO_TAP_APPROVAL=
# Visitor kitchens: how many may exist at once (default 200) and how long each lives in minutes (default 90).
DOCK_SANDBOX_MAX=
DOCK_SANDBOX_TTL_MINUTES=

# Operations portal (/ops). Unset: one click enters as operations staff (demo). Set a passcode before any public demo,
# so a stranger with the link cannot suspend agents. A real deployment puts the wholesaler's single sign-on in front instead.
DOCK_OPS_PASSCODE=
# Crash-test licences per agent as JSON (default .data/licences.json); see src/server/ops/licences.ts.
DOCK_LICENCES_FILE=

# Partner catalogue (Valio Aimo). With VALIO_API_KEY set and the index built (`pnpm index:build`), Dock uses the
# real catalogue and the live price/availability API; otherwise it runs on the 12-product seed.
# Base URL of the partner's mock API (default https://junction26.valioaimo.fi).
VALIO_API_BASE=
# Key for the X-API-Key header (published on the Junction Platform). Never commit it.
VALIO_API_KEY=
# Customer id sent with each request (required by the API, ignored in the challenge; default "dock").
VALIO_CUSTOMER=
# Folder with the partner's data files (default: ../data/valio, seen from web/). Never commit the files.
VALIO_DATA_DIR=
# Index file written by `pnpm index:build` and read at runtime (default: .data/valio/catalog-index.json.gz, git-ignored).
VALIO_INDEX_PATH=
# Set to "seed" to force the seed catalogue even when the real one is available.
DOCK_CATALOG=

# Aiven services (see infra/aiven.md). Fill with `node ../infra/aiven-env.mjs` from web/.
# Names match what Aiven Runtime injects for connected services, except OPENSEARCH_URL (Runtime: OPENSEARCH_URI).
# PostgreSQL service URI (sslmode=require).
DATABASE_URL=
# https://user:password@host:port
OPENSEARCH_URL=
# rediss://default:password@host:port
VALKEY_URL=
# host:port; Kafka uses client certificates. PEM values on one line with \n escapes, double-quoted.
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SECURITY_PROTOCOL=
KAFKA_ACCESS_KEY=
KAFKA_ACCESS_CERT=
KAFKA_CA_CERT=
# Aiven API, for `pnpm infra:check` and the infra scripts. Header: Authorization: aivenv1 <token>.
AIVEN_API_TOKEN=
AIVEN_PROJECT=
AIVEN_ORGANIZATION_ID=
# Read-only application-user token used by Grafana's Infinity data source (infra/grafana/provision.mjs).
AIVEN_READONLY_TOKEN=
# LLM providers (only needed for POST /api/v1/agent/interpret, pnpm agent and pnpm interpret).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# provider:model-id. Unset: the cheap model of the first provider above that has a key.
DOCK_INTERPRET_MODEL=
DOCK_AGENT_MODEL=
# Any OpenAI-compatible endpoint, used as --model compat:<model-id>.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
# Verda (OpenAI-compatible), used as --model verda:<model-id>.
VERDA_BASE_URL=
VERDA_API_KEY=
VERDA_MODEL=
# NVIDIA's hosted API (OpenAI-compatible; base URL defaults to https://integrate.api.nvidia.com/v1), --model nvidia:<model-id>.
NVIDIA_BASE_URL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
# Prices for models not in src/server/agent/pricing.ts, JSON: {"verda:model-id":[input_usd_per_million, output_usd_per_million]}.
DOCK_MODEL_PRICES=
# Set to 1 to run the paid live smoke tests in src/server/agent/live.test.ts.
DOCK_LIVE=
