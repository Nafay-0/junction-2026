# All optional. With none set, Dock runs keyless: an ephemeral wholesaler key and a demo buyer key
# derived from a public string (fine locally, NOT for a public deployment).
# Private Ed25519 JWK (JSON on one line) the wholesaler signs quotes and order confirmations with.
DOCK_WHOLESALER_JWK=
# Private Ed25519 JWK of the demo buyer org (Laakso Catering Oy). Give the demo script the same value.
DOCK_DEMO_ORG_JWK=
# Private Ed25519 JWK of the demo returning kitchen (Ravintola Kaari). Give the demo script the same value.
DOCK_DEMO_KITCHEN_JWK=

# LLM providers (only needed for POST /api/v1/agent/interpret, pnpm agent and pnpm interpret).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# provider:model-id. Unset: the cheap model of the first provider above that has a key.
DOCK_INTERPRET_MODEL=
DOCK_AGENT_MODEL=
# Any OpenAI-compatible endpoint, used as --model compat:<model-id>.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
# Verda (OpenAI-compatible), used as --model verda:<model-id>.
VERDA_BASE_URL=
VERDA_API_KEY=
VERDA_MODEL=
# NVIDIA's hosted API (OpenAI-compatible; base URL defaults to https://integrate.api.nvidia.com/v1), --model nvidia:<model-id>.
NVIDIA_BASE_URL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
# Prices for models not in src/server/agent/pricing.ts, JSON: {"verda:model-id":[input_usd_per_million, output_usd_per_million]}.
DOCK_MODEL_PRICES=
# Set to 1 to run the paid live smoke tests in src/server/agent/live.test.ts.
DOCK_LIVE=
