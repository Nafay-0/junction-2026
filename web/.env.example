# All optional. With none set, AimoPilot runs keyless: an ephemeral wholesaler key and a demo buyer key
# derived from a public string (fine locally, NOT for a public deployment).
# Private Ed25519 JWK (JSON on one line) the wholesaler signs quotes and order confirmations with.
DOCK_WHOLESALER_JWK=
# Private Ed25519 JWK of the demo buyer org (Laakso Catering Oy). Give the demo script the same value.
DOCK_DEMO_ORG_JWK=
# Private Ed25519 JWK of the demo returning kitchen (Ravintola Kaari). Give the demo script the same value.
DOCK_DEMO_KITCHEN_JWK=

# Phone approval (passkeys). All optional for local runs on localhost.
# Public https base of this app: links, QR codes and the passkey origin. Unset: taken from the request's host.
DOCK_PUBLIC_URL=
# Passkey relying-party id (a domain, no scheme). Default: the host of DOCK_PUBLIC_URL / the request.
DOCK_WEBAUTHN_RP_ID=
# Comma-separated origins passkeys may be used from. Default: DOCK_PUBLIC_URL / the request's origin.
DOCK_WEBAUTHN_ORIGINS=
# Name shown in the phone's passkey prompt. Default: AimoPilot.
DOCK_WEBAUTHN_RP_NAME=
# DEMO ONLY. Set to 1 to offer tap-to-approve without a passkey when passkeys fail. Recorded as unverified. Default off.
DOCK_DEMO_TAP_APPROVAL=
# Connector addresses (/api/mcp/c/<token>, for assistants that take only a URL). A long random string; demo kitchens'
# addresses are derived from it, so they stay the same across restarts and deploys. It also lets the operator
# reissue or revoke a demo kitchen's address (Authorization: Bearer <it>). Unset: random addresses per process.
DOCK_CONNECTOR_SECRET=
# Visitor kitchens: how many may exist at once (default 200) and how long each lives in minutes (default 90).
DOCK_SANDBOX_MAX=
DOCK_SANDBOX_TTL_MINUTES=
# Accounts (src/server/accounts). Passwords of the two stage kitchens' accounts (kaari, laakso): set them on the
# deployment and hand them to the presenters only; unset, nobody can sign in to those accounts.
DOCK_KAARI_PASSWORD=
DOCK_LAAKSO_PASSWORD=
# 1 lists the public test accounts (web/src/server/accounts/test-accounts.ts) with their passwords on /k.
DOCK_TEST_ACCOUNTS_SHOWN=
# Minutes between automatic resets of the test accounts (default 60; 0 = only from the operations portal).
DOCK_TEST_ACCOUNTS_RESET_MINUTES=
# Most restaurants' own accounts this server takes (default 1000).
DOCK_ACCOUNTS_MAX=

# Operations portal (/ops). Unset: one click enters as operations staff (demo). Set a passcode before any public demo,
# so a stranger with the link cannot suspend agents. A real deployment puts the wholesaler's single sign-on in front instead.
DOCK_OPS_PASSCODE=
# Crash-test licences per agent as JSON (default .data/licences.json); see src/server/ops/licences.ts.
DOCK_LICENCES_FILE=
# Crash-test licence at the gate: "on" applies the stricter of mandate and licence (default off).
DOCK_LICENCE_ENFORCE=
# Which running agents hold which crash-test licence (default .data/licence-bindings.json; see README "The licence").
DOCK_LICENCE_BINDINGS=

# Partner catalogue (Valio Aimo). With VALIO_API_KEY set and the index built (`pnpm index:build`), AimoPilot uses the
# real catalogue and the live price/availability API; otherwise it runs on the 12-product seed.
# Base URL of the partner's mock API (default https://junction26.valioaimo.fi).
VALIO_API_BASE=
# Key for the X-API-Key header (published on the Junction Platform). Never commit it.
VALIO_API_KEY=
# Customer id sent with each request (required by the API, ignored in the challenge; default "dock").
VALIO_CUSTOMER=
# Folder with the partner's data files (default: ../data/valio, seen from web/). Never commit the files.
VALIO_DATA_DIR=
# Index file written by `pnpm index:build` and read at runtime (default: .data/valio/catalog-index.json.gz, git-ignored).
VALIO_INDEX_PATH=
# Product knowledge map (see docs/knowledge-map.md): map file, build cache, build model, Modal client command
KNOWLEDGE_MAP_PATH=
KNOWLEDGE_CACHE_DIR=
KNOWLEDGE_MODEL=
KNOWLEDGE_MODAL_CMD=
# Set to "seed" to force the seed catalogue even when the real one is available.
DOCK_CATALOG=

# Aiven services (see infra/aiven.md). Fill with `node ../infra/aiven-env.mjs` from web/.
# Names match what Aiven Runtime injects for connected services, except OPENSEARCH_URL (Runtime: OPENSEARCH_URI).
# PostgreSQL service URI (sslmode=require).
DATABASE_URL=
# https://user:password@host:port
OPENSEARCH_URL=
# rediss://default:password@host:port
VALKEY_URL=
# host:port; Kafka uses client certificates. PEM values on one line with \n escapes, double-quoted.
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SECURITY_PROTOCOL=
KAFKA_ACCESS_KEY=
KAFKA_ACCESS_CERT=
KAFKA_CA_CERT=
# Aiven API, for `pnpm infra:check` and the infra scripts. Header: Authorization: aivenv1 <token>.
AIVEN_API_TOKEN=
AIVEN_PROJECT=
AIVEN_ORGANIZATION_ID=
# Read-only application-user token used by Grafana's Infinity data source (infra/grafana/provision.mjs).
AIVEN_READONLY_TOKEN=

# Which Aiven adapters the app uses (src/server/aiven/env.ts). All off by default: everything in memory.
# 1 = every adapter whose service address above is set. The single switches below override it.
DOCK_AIVEN=
# memory | postgres: orders, used quotes, approvals, kitchens, intakes, passkeys, sandboxes, ledger.
DOCK_STORE=
# Schema for those tables (default dock); a new name gives an empty store. Pool size per process (default 4, max 8).
DOCK_PG_SCHEMA=
DOCK_PG_POOL_MAX=
# off | kafka | postgres: the action stream into telemetry.events (Grafana). Topic and consumer group names.
DOCK_ACTIONS=
DOCK_ACTIONS_TOPIC=
DOCK_SINK_GROUP=
# 0 = do not run the Kafka -> telemetry.events consumer in this process (run `pnpm aiven:sink` instead).
DOCK_KAFKA_SINK=
# memory | valkey: live price/availability cache and the per-agent live-lookup budget. Cache cap in seconds (default 120).
DOCK_CACHE=
DOCK_LIVE_CACHE_MAX_S=
# memory | valkey: live events for phones and the big screen across app processes.
DOCK_BUS=
# in-process | opensearch: product search (in-process stays the fallback). Deadline in ms (default 400), index alias.
DOCK_SEARCH=
DOCK_SEARCH_TIMEOUT_MS=
DOCK_SEARCH_ALIAS=
# LLM providers (only needed for POST /api/v1/agent/interpret, pnpm agent and pnpm interpret).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# provider:model-id. Unset: the cheap model of the first provider above that has a key.
DOCK_INTERPRET_MODEL=
DOCK_AGENT_MODEL=
# Kitchen memory (src/server/memory/runtime.ts). Writer model, default anthropic:claude-haiku-5-5; DOCK_MEMORY_LLM=off
# learns from taps and orders only. DOCK_MEMORY_EMBEDDINGS=openai for text-embedding-3-small (default: in process);
# DOCK_MEMORY_VECTORS=pg keeps vectors in PostgreSQL with pgvector (DATABASE_URL).
DOCK_MEMORY_MODEL=
DOCK_MEMORY_LLM=
DOCK_MEMORY_EMBEDDINGS=
DOCK_MEMORY_VECTORS=
# Any OpenAI-compatible endpoint, used as --model compat:<model-id>.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
# Verda (OpenAI-compatible), used as --model verda:<model-id>.
VERDA_BASE_URL=
VERDA_API_KEY=
VERDA_MODEL=
# NVIDIA's hosted API (OpenAI-compatible; base URL defaults to https://integrate.api.nvidia.com/v1), --model nvidia:<model-id>.
NVIDIA_BASE_URL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
# The voice and photo doors (web/docs/doors.md). Voice uses GEMINI_API_KEY; the reader ANTHROPIC_API_KEY by default.
# "off" turns voice calls off. Model, seconds per call, and calls per kitchen per hour / all per hour / per kitchen per day / all per day.
DOCK_VOICE=
DOCK_VOICE_MODEL=
DOCK_VOICE_CALL_SECONDS=
DOCK_VOICE_CALLS_PER_KITCHEN_HOUR=
DOCK_VOICE_CALLS_PER_HOUR=
DOCK_VOICE_CALLS_PER_KITCHEN_DAY=
DOCK_VOICE_CALLS_PER_DAY=
# provider:model-id for reading photos, PDFs and pasted text (default anthropic:claude-haiku-5-5); featherless:<id> uses FEATHERLESS_API_KEY.
DOCK_SCAN_MODEL=
DOCK_SCAN_TIMEOUT_MS=
DOCK_SCANS_PER_KITCHEN_HOUR=
DOCK_SCANS_PER_HOUR=
FEATHERLESS_API_KEY=
# Prices for models not in src/server/agent/pricing.ts, JSON: {"verda:model-id":[input_usd_per_million, output_usd_per_million]}.
DOCK_MODEL_PRICES=
# Set to 1 to run the paid live smoke tests in src/server/agent/live.test.ts.
DOCK_LIVE=

# Public demo limits (src/server/limits.ts, src/proxy.ts). All optional.
# "off" switches every model call off (503 llm_disabled).
DOCK_LLM=
# Model spend (USD) and model calls allowed per UTC day on this server (defaults 5 and 500).
DOCK_LLM_DAILY_USD=
DOCK_LLM_DAILY_CALLS=
# Requests to the partner's live price/availability API per UTC day (default 3000).
DOCK_LIVE_DAILY_CALLS=
# Live-lookup allowance (core/live-allowance.ts), counting only calls that reach the partner: per agent or per
# on-site console session and hour (calls default 60, distinct products default 150), per agent across its console
# sessions and hour (default 600), and all agents per day (default 3000).
DOCK_LIVE_CALLS_PER_HOUR=
DOCK_LIVE_PRODUCTS_PER_HOUR=
DOCK_LIVE_AGENT_CALLS_PER_HOUR=
DOCK_LIVE_CALLS_PER_DAY=
# Seconds a live answer is reused for option cards (quotes always ask afresh; default 120, 0 = off).
DOCK_LIVE_CACHE_SECONDS=
# "off" disables the per-address rate limits (local load tests only).
DOCK_RATE_LIMITS=
# How many proxies append to X-Forwarded-For in front of the app (default 1: Aiven Runtime's edge).
DOCK_TRUSTED_PROXY_HOPS=
# Where an index fetched from PostgreSQL is cached (default .data/valio/cache). Publish one with `pnpm index:publish`.
VALIO_INDEX_CACHE_DIR=
# Git commit shown by /api/health (default: .build-info.json, written by infra/aiven-deploy.mjs).
DOCK_GIT_COMMIT=

# Operations portal, Platform section (src/server/aiven/showcase/config.ts). All read-only; see infra/aiven.md.
DOCK_AIVEN_LAUNCH_TOKEN=
DOCK_COPILOT_PG_URL=
DOCK_SHOWCASE_LAUNCHES_PER_DAY=
DOCK_SHOWCASE_LAUNCH_GAP_S=
DOCK_SHOWCASE_DOCK_URL=
DOCK_SHOWCASE_CREDIT_USD=
DOCK_AIVEN_MCP=
DOCK_AIVEN_MCP_URL=

# Recall radar (src/server/radar): a public base URL Context.dev can reach the drill page at (default DOCK_PUBLIC_URL).
RADAR_PUBLIC_URL=
# "off" stops the radar's schedule (checks only on demand from /ops/radar).
RADAR_POLL=
# Where the radar keeps notices, matches and holds (default .data/radar/state.json; "off" keeps them in memory).
RADAR_STATE_FILE=
# GTIN side index from `pnpm radar:gtins` (default .data/radar/gtins.json.gz).
RADAR_GTIN_INDEX=

# Audit time machine (src/server/mariadb, infra/mariadb/README.md). The address of a MariaDB 11.8 or later server:
# mariadb://user:password@host:3306/dock_audit (add ?ssl=true for a hosted one). Unset: no mirror, nothing connects,
# and /ops/time-machine says no MariaDB is attached. `pnpm mariadb:reproduce` starts a local one on port 3407.
DOCK_MARIADB_URL=
