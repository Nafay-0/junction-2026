# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
# derived from partner data that must not be published (pnpm index:build)
/.data/

# crash test output (pnpm crash)
/crash-results/

# test infrastructure outputs
/tests-live/results/
/e2e/.auth/

# raw image-model output (scripts/art/generate.ts); only compressed files in public/art/ ship
.art-raw/
# visual baselines: taken once the interface settles (pnpm e2e:visual:update); not committed yet
/e2e/visual/__screenshots__/
