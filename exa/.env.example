# Exa project (Hovi). Copy to exa/.env.local and fill in. Never commit real values.
# Add each new variable here with an empty value when you introduce it.
# The app in exa/web reads this file at startup (see exa/web/next.config.ts).

# Exa: search, contents and agent runs. Get a key at https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Claude, through Claude Platform on AWS (Anthropic-operated; not Amazon Bedrock).
# An API key from the AWS console for that service, the workspace it belongs to, and its region.
ANTHROPIC_AWS_API_KEY=
ANTHROPIC_AWS_WORKSPACE_ID=
AWS_REGION=

# Gemini, through Google AI Studio. Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# The live browser (step 2). All optional.
# A long random value that signs approval requests, so they stay valid across restarts and
# across several server instances. Without it a random one is made each time the server starts.
HOVI_APPROVAL_SECRET=
# Set to 1 to show the Chrome window the agent drives (for debugging). Default: hidden.
HOVI_BROWSER_HEADED=
# Set to 0 on a hosted server. Otherwise a sign-in the site will not take from an assisted browser
# (Google) can be done in an ordinary Chrome window opened on the computer that runs the app.
HOVI_BROWSER_WINDOW=
# Where sign-ins are kept, one folder per visitor. Default: ~/.hovi/browser-profiles
HOVI_BROWSER_PROFILES=
