# Exa project (Hovi). Copy to exa/.env.local and fill in. Never commit real values.
# Add each new variable here with an empty value when you introduce it.
# The app in exa/web reads this file at startup (see exa/web/next.config.ts).

# Exa: search, contents and agent runs. Get a key at https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Claude, through Claude Platform on AWS (Anthropic-operated; not Amazon Bedrock).
# An API key from the AWS console for that service, the workspace it belongs to, and its region.
ANTHROPIC_AWS_API_KEY=
ANTHROPIC_AWS_WORKSPACE_ID=
AWS_REGION=

# Gemini, through Google AI Studio. Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# The live browser (step 2). All optional.
# A long random value that signs approval requests, so they stay valid across restarts and
# across several server instances. Without it a random one is made each time the server starts.
HOVI_APPROVAL_SECRET=
# Set to 1 to show the Chrome window the agent drives (for debugging). Default: hidden.
HOVI_BROWSER_HEADED=
# Set to 0 on a hosted server. Otherwise the user can let the agent work in a window of their own
# Chrome (already signed in), which must be on the same computer as the app.
HOVI_OWN_CHROME=
# The folder of that Chrome, if it is not in the usual place for the operating system.
HOVI_CHROME_DIR=
# Where sign-ins are kept, one folder per visitor. Default: ~/.hovi/browser-profiles
HOVI_BROWSER_PROFILES=

# The desktop app (pnpm desktop). Optional, and read from the shell that starts it, not from .env.local.
# The port of the app's server (default 3000; it is started if nothing answers there).
BATON_PORT=
# Or the full address of a server that is already running on this computer.
BATON_URL=

# Accounts and the database. Required: without them nobody can sign in.
# A Postgres database for accounts, sign-ins, conversations and usage. The server creates and
# updates its tables itself when it starts (or run `pnpm db:migrate`). Local example:
# postgres://localhost:5432/beryl   Hosted example: postgres://user:pass@host/db?sslmode=require
DATABASE_URL=
# The one admin account. It is created when the server starts, and its password follows this
# value: change it here and restart. Every other account is created by the admin, under /admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# The name shown for the admin. Optional (default: Admin).
ADMIN_NAME=
