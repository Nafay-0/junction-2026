# Exa project (Beryl). Copy to exa/.env.local and fill in. Never commit real values.
# Add each new variable here with an empty value when you introduce it.
# The app in exa/web reads this file at startup (see exa/web/next.config.ts).

# Exa: search, contents and agent runs. Get a key at https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Claude, through Claude Platform on AWS (Anthropic-operated; not Amazon Bedrock).
# An API key from the AWS console for that service, the workspace it belongs to, and its region.
ANTHROPIC_AWS_API_KEY=
ANTHROPIC_AWS_WORKSPACE_ID=
AWS_REGION=

# Gemini, through Google AI Studio. Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# The desktop app. Optional, and read from the shell that starts or packages it, not from .env.local.
# pnpm desktop: the port of a server on this computer (default 3000; it is started if nothing answers there).
BERYL_PORT=
# pnpm desktop: the address of a server that is already running, here or anywhere else.
BERYL_URL=
# pnpm desktop:pack: the server address the packaged app opens.
BERYL_SERVER_URL=

# Accounts and the database. Required: without them nobody can sign in.
# A Postgres database for accounts, sign-ins, conversations and usage. The server creates and
# updates its tables itself when it starts (or run `pnpm db:migrate`). Local example:
# postgres://localhost:5432/beryl   Hosted example: postgres://user:pass@host/db?sslmode=require
DATABASE_URL=
# The one admin account. It is created when the server starts, and its password follows this
# value: change it here and restart. Every other account is created by the admin, under /admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# The name shown for the admin. Optional (default: Admin).
ADMIN_NAME=
