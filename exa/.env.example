# Exa project (Hovi). Copy to exa/.env.local and fill in. Never commit real values.
# Add each new variable here with an empty value when you introduce it.
# The app in exa/web reads this file at startup (see exa/web/next.config.ts).

# Exa: search, contents and agent runs. Get a key at https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Claude, through Claude Platform on AWS (Anthropic-operated; not Amazon Bedrock).
# An API key from the AWS console for that service, the workspace it belongs to, and its region.
ANTHROPIC_AWS_API_KEY=
ANTHROPIC_AWS_WORKSPACE_ID=
AWS_REGION=

# Gemini, through Google AI Studio. Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
