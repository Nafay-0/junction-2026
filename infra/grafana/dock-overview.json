    {
      "type": "table",
      "id": 11,
      "title": "Services",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "aiven-api"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "aiven-api"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "https://api.aiven.io/v1/project/${project}/service",
          "url_options": {
            "method": "GET"
          },
          "root_selector": "services",
          "columns": [
            {
              "selector": "service_name",
              "text": "service",
              "type": "string"
            },
            {
              "selector": "service_type",
              "text": "type",
              "type": "string"
            },
            {
              "selector": "plan",
              "text": "plan",
              "type": "string"
            },
            {
              "selector": "cloud_name",
              "text": "cloud",
              "type": "string"
            },
            {
              "selector": "state",
              "text": "state",
              "type": "string"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "RUNNING": {
                        "color": "green",
                        "index": 0
                      },
                      "REBUILDING": {
                        "color": "yellow",
                        "index": 1
                      },
                      "POWEROFF": {
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
