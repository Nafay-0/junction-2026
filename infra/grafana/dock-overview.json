    {
      "type": "table",
      "id": 15,
      "title": "Latest pnpm infra:check (pnpm infra:check --record)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dock-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dock-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (rule) rule AS \"service\", ok, value AS \"ms\", ts AS \"checked\", attrs->>'detail' AS \"detail\" FROM telemetry.events WHERE kind = 'infra.check' ORDER BY rule, ts DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ok"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": {
                        "color": "green",
                        "text": "pass",
                        "index": 0
                      },
                      "false": {
                        "color": "red",
                        "text": "FAIL",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
