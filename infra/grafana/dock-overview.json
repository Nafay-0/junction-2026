{
  "uid": "dock-overview",
  "title": "AimoPilot overview",
  "tags": [
    "dock",
    "aiven"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "constant",
        "name": "project",
        "label": "Aiven project",
        "hide": 2,
        "query": "YOUR_AIVEN_PROJECT",
        "current": {
          "text": "YOUR_AIVEN_PROJECT",
          "value": "YOUR_AIVEN_PROJECT"
        }
      },
      {
        "type": "custom",
        "name": "period",
        "label": "Aiven metrics window",
        "query": "hour,day,week",
        "current": {
          "text": "hour",
          "value": "hour"
        },
        "options": [
          {
            "text": "hour",
            "value": "hour",
            "selected": true
          },
          {
            "text": "day",
            "value": "day",
            "selected": false
          },
          {
            "text": "week",
            "value": "week",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "AimoPilot (PostgreSQL telemetry.events, written by the app)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Orders committed",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dock-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dock-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"orders\" FROM telemetry.events WHERE kind = 'order.committed' AND $__timeFilter(ts)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal"
      }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Committed value",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dock-pg"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dock-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(value), 0) AS \"EUR\" FROM telemetry.events WHERE kind = 'order.committed' AND $__timeFilter(ts)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal"
      }
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Human sign-offs",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dock-pg"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dock-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE kind = 'approval.requested') AS \"asked\",\n       count(*) FILTER (WHERE kind = 'approval.granted')   AS \"granted\",\n       count(*) FILTER (WHERE kind = 'approval.denied')    AS \"denied\"\nFROM telemetry.events WHERE kind LIKE 'approval.%' AND $__timeFilter(ts)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal"
      }
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Gate refusals",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dock-pg"
      },
      "gridPos": {
        "x": 14,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dock-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"refused\" FROM telemetry.events WHERE kind = 'gate.refused' AND $__timeFilter(ts)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal"
      }
    },
    {
      "type": "stat",
      "id": 6,
      "title": "Live API calls saved by cache",
      "description": "partner_api.cache_hit rows are answers served from Valkey inside their validity window; partner_api.call rows are real calls to the partner's rate-limited API.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dock-pg"
      },
      "gridPos": {
        "x": 17,
        "y": 1,
        "w": 7,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dock-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE kind = 'partner_api.cache_hit') AS \"saved\",\n       round(100.0 * count(*) FILTER (WHERE kind = 'partner_api.cache_hit')\n             / nullif(count(*), 0), 1) AS \"hit %\"\nFROM telemetry.events WHERE kind IN ('partner_api.call', 'partner_api.cache_hit') AND $__timeFilter(ts)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal"
      }
    },
    {
      "type": "bargauge",
      "id": 7,
      "title": "Refusals by rule",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dock-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dock-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT rule AS \"rule\", count(*) AS \"refusals\" FROM telemetry.events WHERE kind = 'gate.refused' AND $__timeFilter(ts) GROUP BY rule ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-BlYlRd"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left"
      }
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Events per minute",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dock-pg"
      },
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dock-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, '1m'), kind AS metric, count(*) AS value FROM telemetry.events WHERE $__timeFilter(ts) AND kind <> 'infra.check' GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "table",
      "id": 9,
      "title": "Crash-test scores",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dock-pg"
      },
      "gridPos": {
        "x": 18,
        "y": 5,
        "w": 6,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dock-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"time\", coalesce(attrs->>'run', agent_id, '-') AS \"run\", value AS \"score\", attrs->>'notes' AS \"notes\" FROM telemetry.events WHERE kind = 'crashtest.score' AND $__timeFilter(ts) ORDER BY ts DESC LIMIT 50"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "row",
